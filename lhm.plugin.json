              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "required": ["label", "url"],
              "additionalProperties": false
            },
            "description": "Addresses off the site, with the label the page gave them."
          },
